<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>__EXPORT_TITLE__</title>
    <link rel="icon" href="{{ favicon_href }}" type="image/svg+xml">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <style>
        /* ── Material Symbols ─────────────────────────────────────────────────── */
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal; font-style: normal;
            font-size: 16px; line-height: 1;
            letter-spacing: normal; text-transform: none;
            display: inline-block; white-space: nowrap;
            direction: ltr; -webkit-font-smoothing: antialiased;
            vertical-align: middle;
        }

        /* ── Generated at card ─────────────────────────────────────── */
        .generated-at-card .content-card-title {
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .generated-date {
            margin-left: 8px;
            font-size: 13px;
            color: #6c757d;
            font-weight: 400;
            font-style: italic;
        }

        /* ── Info cards repliables (palette « Note bleue » QCR / s44) ─────────── */
        .info-card {
            border: 1px solid #b8cce8;
            border-radius: 14px;
            padding: 14px 20px;
            background-color: #eef3fb;
            box-shadow: 0 1px 5px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        .info-card > summary {
            font-weight: 700; font-size: 14px; color: #3b5999;
            cursor: pointer; user-select: none; list-style: none;
            display: flex; align-items: center; gap: 6px; letter-spacing: 0.2px;
        }
        .info-card > summary::-webkit-details-marker { display: none; }
        .info-card-body {
            margin-top: 10px;
            font-size: 12.5px; color: #3d4a63; line-height: 1.65;
        }
        .info-card-body p { margin: 4px 0 8px 0; }
    </style>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            padding-top: 182px;
            background: #f0f2f5;
            font-family: {{ font_family }};
        }
        button, input, select, textarea { font-family: inherit; }

        /* ── Header ────────────────────────────────────────────────────────────── */
        .app-header {
            position: fixed; top: 0; left: 0; right: 0; min-height: 120px;
            background-color: #2c3e50; color: white;
            display: flex; flex-direction: column;
            align-items: flex-start; justify-content: center;
            padding: 12px 24px;
            z-index: 1100; box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        }
        .app-header h5 { margin: 0 0 4px 0; font-size: 38px; font-weight: 700; }
        .app-header-desc {
            font-size: 13px; color: rgba(255,255,255,0.72);
            margin: 0; line-height: 1.4; max-width: 850px;
        }

        /* ── Barre d'onglets (Bootstrap nav-tabs, positionnement fixe, style S-44) ── */
        .tab-nav {
            position: fixed; top: 120px; left: 0; right: 0;
            background: #f4f6f8;
            border-bottom: 1px solid #dee2e6;
            z-index: 1099;
            padding: 10px 24px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.07);
        }
        .tab-nav .nav-tabs {
            border-bottom: none;
            display: flex;
            gap: 8px;
            flex-wrap: nowrap;
            align-items: stretch;
        }
        .tab-nav .nav-tabs .nav-item {
            flex: 1 1 0;
            min-width: 0;
            display: flex;
        }
        /* Overrides Bootstrap nav-tabs → style "pill arrondi" S-44 */
        .tab-nav .nav-tabs .nav-link {
            border-radius: 10px !important;
            background-color: #eef1f5;
            color: #6c757d;
            border: 1px solid #dee2e6 !important;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.3px;
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 18px;
            transition: background-color 0.15s, color 0.15s, border-color 0.15s;
        }
        .tab-nav .nav-tabs .nav-link:hover:not(.active) {
            background-color: #e4e8ed;
            color: #495057;
            border-color: #c8cfd8 !important;
        }
        .tab-nav .nav-tabs .nav-link.active {
            background-color: #ffffff;
            color: #495057;
            font-weight: 600;
            border: 2px solid #4e79a7 !important;
            box-shadow: 0 1px 4px rgba(0,0,0,0.10);
        }
        @media (max-width: 514px) {
            .tab-nav .nav-tabs          { flex-wrap: wrap; }
            .tab-nav .nav-tabs .nav-item { flex: 0 0 100%; }
        }

        /* ── Cards ──────────────────────────────────────────────────────────────── */
        .content-card {
            border: 1px solid #dee2e6; border-radius: 14px;
            padding: 24px 28px; background: #fff;
            box-shadow: 0 1px 5px rgba(0,0,0,0.07); margin-bottom: 20px;
        }
        .content-card-title {
            font-weight: 700; font-size: 14px; color: #6c757d;
            text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 16px;
            display: flex; align-items: center; gap: 8px;
            padding-top: 8px;
            padding-bottom: 8px;
        }
        .content-card-title .material-symbols-outlined {
            font-size: 18px; color: #4e79a7;
        }
        /* Carte contenant une figure Plotly — pas de padding bas, overflow caché */
        .content-card-figure {
            overflow: hidden;
            position: relative;
        }
        .content-card-figure .plotly-graph-div { width: 100% !important; }
        .content-card-figure > div { margin: 0 !important; }

        /* ── Paramètres ─────────────────────────────────────────────────────────── */
        .param-block { margin-top: 14px; }
        .param-block:first-child { margin-top: 0; }
        .param-label {
            font-weight: 600; font-size: 13px; color: #495057;
            margin-bottom: 6px; display: block;
        }
        .param-value { font-size: 13px; color: #2c3e50; }
        .none-text { font-size: 13px; font-style: italic; color: #6c757d; }

        /* ── Table ───────────────────────────────────────────────────────────────── */
        .content-card table {
            width: 100%; border-collapse: separate; border-spacing: 0;
            table-layout: fixed;
            font-size: 13px; font-family: inherit;
            border: 1px solid #dee2e6; border-radius: 10px; overflow: hidden;
        }
        .content-card table thead th {
            background-color: #2c3e50; color: white;
            font-weight: 600; font-size: 12px;
            text-align: center;
            border-right: 1px solid #4a6278;
            border-bottom: 2px solid rgba(255,255,255,0.15);
            padding: 8px 12px;
        }
        .content-card table thead th:last-child { border-right: none; }
        .content-card table tbody td {
            text-align: left; font-family: inherit;
            padding: 8px 12px;
            border-right: 1px solid #dee2e6;
            border-bottom: 1px solid #dee2e6;
            word-wrap: break-word;
        }
        .content-card table tbody td:last-child { border-right: none; }
        .content-card table tbody tr:last-child td { border-bottom: none; }
        .content-card table tbody td:first-child {
            font-weight: 600; color: #495057;
            background-color: #f8f9fa;
        }
        .table-striped > tbody > tr:nth-of-type(odd) > td:not(:first-child) {
            --bs-table-bg-type: #f8f9fa;
        }
    </style>
    <style>
        /* ── Editable cells ──────────────────────────────────────────────────── */
        .editable-cell {
            cursor: text;
            transition: background-color 0.15s;
            outline: none;
        }
        .editable-cell:empty::before {
            content: '—';
            color: #adb5bd;
            font-style: italic;
        }
        .editable-cell:hover {
            background-color: #f0f7ff !important;
        }
        .editable-cell:focus {
            background-color: #e8f4fd !important;
            outline: 2px solid #4e79a7;
            outline-offset: -2px;
            box-shadow: inset 0 0 0 2px rgba(78,121,167,0.15);
        }
        .editable-cell.modified {
            background-color: #fffbe6 !important;
            border-left: 3px solid #e6a800 !important;
            padding-left: 9px !important;
        }

        /* ── Modification date (next to generated-at) ────────────────────────── */
        .modified-date {
            display: none;
            margin-left: 20px;
            font-size: 13px;
            color: #e6a800;
            font-weight: 500;
            font-style: italic;
        }
        .modified-date.visible { display: inline; }

        /* ── Save bar (barre fixe en bas) ────────────────────────────────────── */
        body { padding-bottom: 68px; }
        .save-bar {
            position: fixed; bottom: 0; left: 0; right: 0;
            background: #2c3e50;
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 24px;
            z-index: 1200;
            box-shadow: 0 -2px 8px rgba(0,0,0,0.3);
            gap: 16px;
        }
        .save-bar-info {
            font-size: 12px; color: rgba(255,255,255,0.72);
            flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap;
        }
        .save-bar-info strong {
            color: #fff; font-size: 13px;
            display: block; margin-bottom: 1px;
        }
        .save-btn {
            display: inline-flex; align-items: center; gap: 7px;
            background-color: #4e79a7; color: #fff;
            border: none; border-radius: 8px;
            padding: 9px 18px; font-size: 13px; font-weight: 600;
            cursor: pointer; white-space: nowrap;
            transition: background-color 0.15s, transform 0.1s;
            flex: 0 0 auto;
        }
        .save-btn:hover:not(:disabled) { background-color: #3a5f8a; transform: translateY(-1px); }
        .save-btn:active:not(:disabled) { transform: translateY(0); }
        .save-btn:disabled  { opacity: 0.55; cursor: not-allowed; }
        .save-btn .material-symbols-outlined { font-size: 18px; }

        /* ── Toast notification ──────────────────────────────────────────────── */
        .toast-notif {
            position: fixed; bottom: 72px; right: 24px;
            padding: 11px 18px; border-radius: 10px;
            font-size: 13px; font-weight: 500;
            box-shadow: 0 4px 14px rgba(0,0,0,0.18);
            z-index: 1300; pointer-events: none; color: #fff;
            opacity: 0; transform: translateY(6px);
            transition: opacity 0.22s, transform 0.22s;
        }
        .toast-notif.success { background: #2e7d32; }
        .toast-notif.info    { background: #1565c0; }
        .toast-notif.show    { opacity: 1; transform: translateY(0); }
    </style>
</head>
<body>

<div class="app-header">
    <h5>__EXPORT_TITLE__</h5>
    <p class="app-header-desc">{{ labels.report_subtitle }}</p>
</div>

<nav class="tab-nav">
    <ul class="nav nav-tabs" id="reportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-metadata"
                    type="button" role="tab"
                    aria-controls="tab-metadata" aria-selected="true">
                <span class="material-symbols-outlined">description</span>
                {{ labels.tab_metadata }}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-stats"
                    type="button" role="tab"
                    aria-controls="tab-stats" aria-selected="false">
                <span class="material-symbols-outlined">monitoring</span>
                {{ labels.tab_stats }}
            </button>
        </li>
    </ul>
</nav>

<div class="container-fluid py-4">
    <div class="tab-content" id="reportTabContent">

        <!-- ──────────────────────────────────────────────────────────────────── -->
        <!-- Onglet 1 — Métadonnées                                                -->
        <!-- ──────────────────────────────────────────────────────────────────── -->
        <div id="tab-metadata" class="tab-pane fade show active" role="tabpanel"
             aria-labelledby="tab-metadata-btn">

            <div class="content-card generated-at-card">
                <div class="content-card-title">
                    <span class="material-symbols-outlined">schedule</span>
                    {{ labels.generated_at }} <span class="generated-date">__GENERATED_AT__</span><span class="modified-date" id="modifiedDateDisplay"></span>
                </div>
            </div>

            __METADATA_SECTIONS__

        </div>

        <!-- ──────────────────────────────────────────────────────────────────── -->
        <!-- Onglet 2 — Statistiques                                               -->
        <!-- ──────────────────────────────────────────────────────────────────── -->
        <div id="tab-stats" class="tab-pane fade" role="tabpanel"
             aria-labelledby="tab-stats-btn">

            <!--STATS_CONTENT-->

        </div>

    </div>
</div>

<!-- ── Barre de sauvegarde ─────────────────────────────────────────────────── -->
<div class="save-bar" id="saveBar">
    <div class="save-bar-info">
        <strong>{{ labels.edit_metadata_title }}</strong>
        {{ labels.edit_metadata_info }}
    </div>
    <button class="save-btn" id="saveBtnHtml">
        <span class="material-symbols-outlined">save</span>
        {{ labels.save_to_html }}
    </button>
</div>

<!-- Toast notification -->
<div class="toast-notif" id="toastNotif"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ── Constants injected by Python (i18n + report UUID) ─────────────────────
    var REPORT_ID       = '__REPORT_ID__';
    var STORAGE_KEY     = 'csb-report-' + REPORT_ID;
    var MSG_SAVED       = '__SAVED_TEXT__';
    var MSG_RESTORED    = '__RESTORED_TEXT__';
    var MSG_MODIFIED_ON = '__MODIFIED_ON_TEXT__';

    // ── Utilities ─────────────────────────────────────────────────────────────
    function _pad(n) { return String(n).padStart(2, '0'); }

    function _formatDateTimeFile(d) {
        return d.getFullYear() + '-' + _pad(d.getMonth() + 1) + '-' + _pad(d.getDate()) +
               '_' + _pad(d.getHours()) + '-' + _pad(d.getMinutes());
    }

    function _formatDateTimeDisplay(d) {
        return d.getFullYear() + '-' + _pad(d.getMonth() + 1) + '-' + _pad(d.getDate()) +
               ' ' + _pad(d.getHours()) + ':' + _pad(d.getMinutes()) + ':' + _pad(d.getSeconds());
    }

    function showToast(message, type) {
        var el = document.getElementById('toastNotif');
        el.textContent = message;
        el.className = 'toast-notif ' + (type || 'success') + ' show';
        clearTimeout(el._hideTimer);
        el._hideTimer = setTimeout(function () { el.classList.remove('show'); }, 3200);
    }

    // ── Editable cells ────────────────────────────────────────────────────────
    function _markCell(cell) {
        var isDirty = cell.textContent !== cell.getAttribute('data-original');
        cell.classList.toggle('modified', isDirty);
    }

    function _persistCell(cell) {
        var key      = cell.getAttribute('data-key');
        var original = cell.getAttribute('data-original');
        var current  = cell.textContent;
        var stored   = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        if (current !== original) {
            stored[key] = { value: current, at: new Date().toISOString() };
        } else {
            delete stored[key];
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(stored));
    }

    function _restoreFromStorage() {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return false;
        var mods;
        try { mods = JSON.parse(raw); } catch (e) { return false; }
        var cells = document.querySelectorAll('.editable-cell');
        var anyRestored = false;
        cells.forEach(function (cell) {
            var item = mods[cell.getAttribute('data-key')];
            if (!item) return;
            // Only apply if stored value differs from the HTML baseline
            if (item.value !== cell.getAttribute('data-original')) {
                cell.textContent = item.value;
                cell.classList.add('modified');
                anyRestored = true;
            }
        });
        return anyRestored;
    }

    // ── Modification date display (baked in before serialisation) ─────────────
    function _updateModifiedDateDisplay(now) {
        var el = document.getElementById('modifiedDateDisplay');
        if (!el) return;
        el.textContent = '\u2014 ' + MSG_MODIFIED_ON + ' ' + _formatDateTimeDisplay(now);
        el.classList.add('visible');
    }

    // ── Save to HTML file ─────────────────────────────────────────────────────
    async function saveHtmlFile() {
        var btn = document.getElementById('saveBtnHtml');
        btn.disabled = true;
        try {
            var now = new Date();

            // Stamp the modification date into the DOM before serialising
            _updateModifiedDateDisplay(now);

            // Build suggested filename: sanitised title + datetime suffix
            var base  = document.title
                            .replace(/[<>:"/\\|?*\x00-\x1f]/g, '_')
                            .replace(/\s+/g, '_')
                            .replace(/_+/g, '_')
                            .replace(/^_|_$/g, '');
            var fname = base + '_[' + _formatDateTimeFile(now) + ']'+ '.html';

            // Serialise the live DOM — contenteditable values are already in textContent
            var html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
            var blob = new Blob([html], { type: 'text/html;charset=utf-8' });

            if (window.showSaveFilePicker) {
                // File System Access API — shows native Save As dialog
                var handle = await window.showSaveFilePicker({
                    suggestedName: fname,
                    types: [{ description: 'HTML', accept: { 'text/html': ['.html'] } }]
                });
                var writable = await handle.createWritable();
                await writable.write(blob);
                await writable.close();
            } else {
                // Fallback: silent <a download> (Firefox, Safari)
                var url = URL.createObjectURL(blob);
                var a   = document.createElement('a');
                a.href  = url;
                a.download = fname;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }
            showToast(MSG_SAVED, 'success');
        } catch (e) {
            // AbortError = user cancelled the dialog — ignore silently
            if (e && e.name !== 'AbortError') { console.error('CSB save error:', e); }
        } finally {
            btn.disabled = false;
        }
    }

    // ── Init ──────────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {

        // 1. Wire up the save button
        //    — re-enable in case a disabled state was baked in from a previous save,
        //    — bind via addEventListener (more reliable than a serialised onclick).
        var saveBtn = document.getElementById('saveBtnHtml');
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.addEventListener('click', saveHtmlFile);
        }

        // 2. Wire up each editable value cell
        document.querySelectorAll('.editable-cell').forEach(function (cell) {
            // Reset any CSS state serialised from a previous save; store baseline
            cell.classList.remove('modified');
            cell.setAttribute('data-original', cell.textContent);

            cell.addEventListener('input', function () {
                _markCell(this);
                _persistCell(this);
            });

            // Prevent Enter from inserting block elements
            cell.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); this.blur(); }
            });
        });

        // 3. Restore any locally-saved modifications (auto-persisted on previous visits)
        if (_restoreFromStorage()) {
            showToast(MSG_RESTORED, 'info');
        }

        // 4. Resize Plotly figures when a tab becomes visible
        document.querySelectorAll('#reportTabs button[data-bs-toggle="tab"]').forEach(function (btn) {
            btn.addEventListener('shown.bs.tab', function (e) {
                if (typeof Plotly === 'undefined') return;
                var pane = document.querySelector(e.target.getAttribute('data-bs-target'));
                if (!pane) return;
                pane.querySelectorAll('.plotly-graph-div').forEach(function (div) {
                    Plotly.Plots.resize(div);
                });
            });
        });
    });
</script>

</body>
</html>
